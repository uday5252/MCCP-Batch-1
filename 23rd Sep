class Solution {
    public void reverseString(char[] s) {
        
        // s = [ 'H', 'e', 'l', 'l', 'o' ]
        int left = 0;
        int right = s.length - 1;

        // l = 0 and r = 4

        // s = [ 'H', 'e', 'l', 'l', 'o' ]
        
        while(left < right)
        {
            char temp = s[left];
            s[left] = s[right];
            s[right] = temp;

            left++;
            right--;
        }







    }
}
