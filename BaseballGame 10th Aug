import java.util.ArrayList;
import java.util.Stack;

public class Baseball {

	public static void main(String[] args) {
	
	 	ArrayList<String> al = new ArrayList<String>();
	 	al.add("5");
	 	al.add("2");
	 	al.add("C");
	 	al.add("D");
	 	al.add("+");
	 	
//	 	["5", "2", "C", "D", "+"]
	 	
	 	Stack<String> output = new Stack<String>();

	 	for(int i = 0; i < al.size(); i++)
	 	{
	 		if(al.get(i).equals("C"))
	 		{
	 			output.pop();
	 		}
	 		else if(al.get(i).equals("D"))
	 		{
//	 			logic for double
	 			int doubledNumber = Integer.parseInt(output.peek()) * 2;
	 			output.add(String.valueOf(doubledNumber));
	 		}
//	 		"5" ==> 5
	 		else if(al.get(i).equals("+"))
	 		{
//	 			logic for addition of last 2 elements
	 			System.out.println(output.peek());
	 			System.out.println(output.peek());
	 		}
	 		else
	 		{
	 			output.add(al.get(i));
	 		}
	 		
	 	}
	 	
//	 	System.out.println(output);
	 	
	 	
	 	
	}

}
