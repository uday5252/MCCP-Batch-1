class Solution {
    public String reverseOnlyLetters(String s) {

        // s = "Ra-ju"
        char info[] = s.toCharArray();// [ 'R', 'a', '-', 'j', 'u' ]
        
        int left = 0;
        int right = info.length - 1;

        while(left < right)
        {
                if(!Character.isLetter(info[left]))
            {
                left++;
            }
            else if(!Character.isLetter(info[right]))
            {
                right--;
            }
            else
            {
                // left and right both are letters
                char temp = info[left];
                info[left] = info[right];
                info[right] = temp;
                left++;
                right--;
            }

        }
        // [ 'R', 'a', '-', 'j', 'u' ] ==> [ 'u', 'j', '-', 'a', 'R' ] 
        // ==> "uj-aR"

        return new String(info);
    }
}
